# ============================================================
#  AGENDPRO SAAS — Variáveis de Ambiente (DEPLOY NA VERCEL)
# ============================================================
#  Como usar:
#  1. Na Vercel: Project Settings → Environment Variables
#  2. Copie o NOME das variáveis abaixo (ex: SUPABASE_URL)
#  3. Preencha os VALORES do seu projeto Supabase (ixwdnrvgtdcdljqtgfzb)
#  4. Marque todas para: Production ✅ + Preview ✅ + Development ✅
#  5. Salve → Deploy!
# ============================================================

# ============================================================
#  🔑 SUPABASE (OBRIGATÓRIAS — 3 PRINCIPAIS)
# ============================================================

# URL do projeto Supabase (Dashboard Supabase → Project Settings → API → Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave anônima pública (anon public) — NÃO É SECRETA, pode ficar exposta no frontend
# Dashboard Supabase → Project Settings → API → Project API keys → anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave SERVICE ROLE (ULTRA SECRETA — USAR APENAS NO BACKEND!)
# NÃO COLOQUE NO FRONTEND / NÃO COMMITE NO GITHUB.
# Apenas usada em /pages/api/* (lado servidor Node.js da Vercel)
# Dashboard Supabase → Project Settings → API → Project API keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
#  🌐 APP URL (MUDAR PARA SEU DOMÍNIO NA VERCEL)
# ============================================================

# URL pública do seu app (será ex: https://clinicasprojeto.vercel.app
# ou seu domínio próprio: https://agendpro.com.br)
# Usada para links em e-mails, callbacks de pagamento, etc.
NEXT_PUBLIC_APP_URL=https://SEU-PROJETO.vercel.app

# ============================================================
#  ⚡ PERFORMANCE / CACHE (OBRIGATÓRIAS PARA FUNCIONAR)
# ============================================================

# Desativa telemetria Next.js (opcional, recomendado)
NEXT_TELEMETRY_DISABLED=1

# (Opcional) Cache local do Next.js — só necessário em ambientes com AppData bloqueado
# Na Vercel NÃO PRECISA, pode deixar vazio ou remover.
# XDG_CACHE_HOME=/tmp/.next-cache

# ============================================================
#  🔗 INTEGRAÇÕES (OPCIONAIS — deixar em branco por enquanto)
#  Serão usadas futuramente pelas stubs em /integrations/
# ============================================================

# WhatsApp Oficial (Meta Cloud API) — preencher quando for ativar
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WABA_ID=

# E-mail transacional (Resend / Sendgrid / SMTP)
# EMAIL_FROM=no-reply@seudominio.com.br
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Pagamento (Stripe / Mercado Pago)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_PUBLIC_KEY=

# Google Calendar (integração agenda profissional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# ============================================================
#  👮 AUTENTICAO (OPCIONAL — usar SSO Google/Facebook futuramente)
# ============================================================

# NextAuth / OAuth providers (se for adicionar login social)
# NEXTAUTH_URL=https://SEU-PROJETO.vercel.app
# NEXTAUTH_SECRET=gerar-com-openssl-rand-base64-32

# GOOGLE_ID=
# GOOGLE_SECRET=
# FACEBOOK_ID=
# FACEBOOK_SECRET=
