# Exemplo de variáveis de ambiente - Copie para .env e preencha com suas chaves reais

# URL do projeto Supabase (encontre em Project Settings -> API)
SUPABASE_URL=

# Chave anônima pública (anon public) - usada no frontend (encontre em Project Settings -> API)
SUPABASE_ANON_KEY=

# Chave Service Role - USAR APENAS NO BACKEND / API Routes (NÃO EXPOR NO FRONTEND)
# Encontre em Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# URL base do app (para links em e-mails, etc)
NEXT_PUBLIC_APP_URL=http://localhost:8080

# Desabilita telemetria Next.js (evita escrita em AppData em ambientes restritos)
NEXT_TELEMETRY_DISABLED=1

# Cache do Next.js local dentro do workspace (contorna sandbox que bloqueia AppData)
XDG_CACHE_HOME=./.next-cache
